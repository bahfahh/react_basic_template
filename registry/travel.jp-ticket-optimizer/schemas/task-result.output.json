{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "packageId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "statusLabel": {
      "type": "string"
    },
    "bucket": {
      "type": "string",
      "enum": [
        "needs_input",
        "awaiting_approval",
        "in_progress",
        "submitted",
        "resolved",
        "stopped"
      ]
    },
    "completionSubstate": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "submitted",
            "resolved_success",
            "resolved_no_recovery"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "statusReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "missingFields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "label",
          "hint"
        ],
        "additionalProperties": false
      }
    },
    "webUrl": {
      "type": "string"
    },
    "comparison": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "asOf": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "recommendedStrategyId": {
              "type": "string",
              "enum": [
                "singles",
                "pass_first",
                "optimized"
              ]
            },
            "baselineCostJpy": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "recommendedCostJpy": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "estimatedSavingsJpy": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "estimatedSavingsNote": {
              "type": "string"
            },
            "strategies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "totalJpy": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "feasible": {
                    "type": "boolean"
                  },
                  "passes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string"
                        },
                        "category": {
                          "type": "string"
                        },
                        "count": {
                          "type": "number"
                        },
                        "startDate": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "coversDates": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        },
                        "unitPrice": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "productId",
                        "category",
                        "count",
                        "startDate",
                        "coversDates",
                        "unitPrice"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "title",
                  "totalJpy",
                  "feasible",
                  "passes"
                ],
                "additionalProperties": false
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warn",
                      "block"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "severity",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "checkedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "freshness": {
                    "type": "string",
                    "enum": [
                      "fresh",
                      "stale"
                    ]
                  }
                },
                "required": [
                  "title",
                  "url",
                  "type",
                  "checkedAt",
                  "freshness"
                ],
                "additionalProperties": false
              }
            },
            "handoffAllowed": {
              "type": "boolean"
            },
            "resultHash": {
              "type": "string"
            }
          },
          "required": [
            "asOf",
            "recommendedStrategyId",
            "baselineCostJpy",
            "recommendedCostJpy",
            "estimatedSavingsJpy",
            "estimatedSavingsNote",
            "strategies",
            "warnings",
            "sources",
            "handoffAllowed",
            "resultHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingApprovals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "prefill_booking"
          },
          "title": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "amountJpy": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "payloadHash": {
            "type": "string"
          },
          "approveIn": {
            "type": "string"
          }
        },
        "required": [
          "actionId",
          "type",
          "title",
          "target",
          "amountJpy",
          "payloadHash",
          "approveIn"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "handoffUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "actionId",
          "title",
          "status",
          "handoffUrl"
        ],
        "additionalProperties": false
      }
    },
    "evidenceCount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "outcome": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "substate": {
              "type": "string"
            },
            "estimatedSavings": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "verifiedSavings": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "verified",
                "unverified"
              ]
            }
          },
          "required": [
            "substate",
            "estimatedSavings",
            "verifiedSavings",
            "confidence"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "packageId",
    "status",
    "statusLabel",
    "bucket",
    "completionSubstate",
    "statusReason",
    "missingFields",
    "webUrl",
    "comparison",
    "pendingApprovals",
    "actions",
    "evidenceCount",
    "outcome",
    "updatedAt"
  ],
  "additionalProperties": false
}
