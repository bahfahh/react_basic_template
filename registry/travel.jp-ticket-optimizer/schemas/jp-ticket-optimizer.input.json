{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "travelDates": {
      "description": "travel_dates",
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "travelers": {
      "description": "travelers",
      "type": "object",
      "properties": {
        "adults": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "childAges": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17
          }
        }
      },
      "required": [
        "adults",
        "childAges"
      ],
      "additionalProperties": false
    },
    "lodgingCity": {
      "description": "lodging_area",
      "type": "string",
      "maxLength": 40
    },
    "days": {
      "description": "destinations_or_attractions",
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "city": {
            "type": "string",
            "maxLength": 40
          },
          "attractions": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            }
          },
          "rides": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "osaka_metro",
                "kyoto_bus",
                "kyoto_subway",
                "jr_local",
                "hankyu_intercity"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "required": [
          "date",
          "city",
          "attractions"
        ],
        "additionalProperties": false
      }
    },
    "preferredTimes": {
      "description": "preferred_times",
      "type": "string",
      "enum": [
        "daytime",
        "evening",
        "any"
      ]
    },
    "flexibility": {
      "description": "flexibility",
      "type": "string",
      "enum": [
        "fixed",
        "flexible"
      ]
    },
    "discountEligibility": {
      "description": "discount_eligibility",
      "type": "object",
      "properties": {
        "foreignPassport": {
          "type": "boolean"
        }
      },
      "required": [
        "foreignPassport"
      ],
      "additionalProperties": false
    },
    "origin": {
      "description": "origin",
      "type": "string",
      "maxLength": 60
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
