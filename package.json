{
  "name": "lazypack-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run packs && vite",
    "packs": "tsx scripts/build-packs.ts",
    "build": "npm run packs && tsc -b && vite build",
    "build:demo": "npm run packs && tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check:sources": "tsx scripts/check-sources.ts",
    "validate": "tsx scripts/validate-pack.ts",
    "probe": "tsx scripts/probe-urls.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.503.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.5.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
