{
  "name": "lazypack-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "export:schemas": "tsx scripts/export-package-artifacts.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.503.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.5.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
