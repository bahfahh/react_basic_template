  "title": "日本票券省錢助手（大阪・京都）",
  "summary": "比較交通單買、一日券／周遊卡與混搭組合，算出同等權益下的最低總價，附官方來源與查詢日期，並協助準備購買（停在付款前）。",
  "inputs": {
    "required": [
      "travel_dates",
      "travelers",
      "destinations_or_attractions"
    ],
    "optional": [
      "origin",
      "lodging_area",
      "preferred_times",
      "flexibility",
      "discount_eligibility"
    ]
  },
  "outputs": [
    "comparable_options",
    "recommended_purchase_bundle",
    "itemized_total_cost",
    "savings_baseline_and_method",
    "source_urls_and_checked_at",
    "restrictions_and_uncertainties",
    "booking_handoff"
  ],
  "humanApproval": [
    "login_to_external_service",
    "submit_personal_information",
    "reserve_or_purchase",
    "any_payment"
  ],
  "prohibited": [
    "bypass_captcha",
    "store_plaintext_credentials",
    "auto_pay_without_explicit_confirmation",
    "claim_unverified_discounts"
  ],
